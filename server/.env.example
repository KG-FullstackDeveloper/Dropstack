# ==============================
# MEO STORE — BACKEND CONFIG
# ==============================

NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# ==============================
# AI
# ==============================

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# ==============================
# SECURITY — CHANGE THESE VALUES
# ==============================

JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
OWNER_EMAIL=toxicfullstackdeveloper@gmail.com
OWNER_PASSWORD=REPLACE_WITH_YOUR_SECURE_ADMIN_PASSWORD

# ==============================
# DATABASE
# ==============================

DATABASE_PATH=./dropstack.db
BACKUP_KEEP=7

# ==============================
# EMAIL — GMAIL SMTP
# ==============================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=YOUR_GMAIL_ADDRESS
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
EMAIL_FROM=YOUR_GMAIL_ADDRESS
STORE_OWNER_EMAIL=toxicfullstackdeveloper@gmail.com

# ==============================
# WHATSAPP — OPTIONAL
# GLOBAL STORE ONLY
# ==============================

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Store-owner alert when a new order arrives
STORE_OWNER_WHATSAPP=
WHATSAPP_NEW_ORDER_TEMPLATE=

# Customer shipping notifications
# Keep disabled until customer opt-in is collected
WHATSAPP_CUSTOMER_SHIPPING_UPDATES_ENABLED=false
WHATSAPP_SHIPPING_TEMPLATE=

# ==============================
# OPTIONAL — CLOUDINARY
# ==============================

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==============================
# FRONTEND API URL
# ==============================
# Put this in client/.env if your Vite frontend needs it.
# It is not normally required in server/.env.

VITE_API_URL=http://localhost:4000/api